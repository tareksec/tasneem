# =============================================================================
# Tasneem Knitting Industry - Environment Variables (.env.example)
# =============================================================================
# IMPORTANT FOR HOSTINGER DEPLOYMENT:
# In Hostinger hPanel -> Websites -> Manage -> Node.js dashboard:
# Add these environment variables under the "Environment Variables" section.
# =============================================================================

# Hostinger Built-in MySQL Database Connection String
# Format: mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# Hostinger typically uses 'localhost' or '127.0.0.1' for the DB_HOST when Node.js runs on the same server.
# Example: mysql://u123456789_tasneem_user:P@ssword1234!@localhost:3306/u123456789_tasneem_db
DATABASE_URL="mysql://u123456789_tasneem_user:your_mysql_password_here@localhost:3306/u123456789_tasneem_db"

# NextAuth.js Authentication Configuration
# In production, set this to your exact live domain:
NEXTAUTH_URL="https://tasneemknitindustry.com"

# Generate a strong 32+ character random secret.
# In terminal/bash, you can run: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_a_secure_random_32_character_string_here"

# One-time Database Seed Authorization Secret (Used by /api/setup-db?secret=...)
# After deployment, open: https://tasneemknitindustry.com/api/setup-db?secret=YOUR_SETUP_SECRET
SETUP_SECRET="replace_with_a_secure_setup_secret_here"

# Default Super Admin Account (Used by the seed API / script)
# After running seed once, you can log in to /admin/login with these credentials.
ADMIN_EMAIL="admin@tasneem.com"
ADMIN_PASSWORD="TasneemAdmin2026!Secure"
ADMIN_NAME="Tasneem Admin Staff"

# Google Search Console Verification Token
NEXT_PUBLIC_GSC_VERIFICATION="wGKuU1wkzeFDwhHUp-7bNHpZsxE1cc9jD5a1tcbId7E"

# =============================================================================
# Hostinger SMTP Email Configuration (Nodemailer)
# =============================================================================
# Obtain these from Hostinger hPanel -> Emails -> [your email] -> Connect Devices
# Recommended Port: 465 (with SSL) or 587 (with TLS)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="no-reply@tasneemknitindustry.com"
SMTP_PASS="your_hostinger_email_password_here"
SMTP_FROM='"Tasneem Knitting Industry" <no-reply@tasneemknitindustry.com>'
APP_URL="https://tasneemknitindustry.com"

